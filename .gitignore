# 私有版產出，一個位元組都不能進來
_private/
private_data.json
index_full.html

# 金鑰
.env
.env.*
*.key
*.pem
credentials.json
token.json
secrets.json

# 執行期產物
*.log
__pycache__/
*.pyc

# 編輯器 / 作業系統
desktop.ini
Thumbs.db
.DS_Store
.vscode/
.idea/

