{"code":"6182","name":"合晶","meetings":[{"date":"2026-08-06","note":"本公司受邀參加富邦證券所舉辦之法人說明會","source":"簡報","deck_zh":"https://mopsov.twse.com.tw/nas/STR/618220260806M001.pdf","deck_en":"https://mopsov.twse.com.tw/nas/STR/618220260806E001.pdf","av":["https://youtu.be/VqEW8XhMJHI"],"memo":[{"points":[{"text":"2026年策略重點包含二林基地一期建置完成及提升量產能力。","ts":null,"who":null}],"title":"亮點"},{"points":[{"text":"2026Q1 營業收入為 24.78 億元，較去年同期 23.04 億元成長。","ts":null,"who":null},{"text":"2026Q1 銷售地區以臺灣占比 35% 最高，其次為歐洲 25.4%。","ts":null,"who":null},{"text":"2026Q1 重摻矽晶圓營收占比為 59%，輕摻矽晶圓為 41%。","ts":null,"who":null}],"title":"營收"},{"points":[{"text":"2026Q1 毛利率為 19.02%，營業淨利率為 1.06%。","ts":null,"who":null},{"text":"2026Q1 歸屬於母公司業主淨利為 2 百萬元，每股盈餘為 0 元。","ts":null,"who":null}],"title":"毛利與獲利"},{"points":[{"text":"2026年重點為核心布局產品項驗證及小量投產前置準備。","ts":null,"who":null}],"title":"營運指引"},{"points":[{"text":"彰化二林廠一期 2027 年月產能目標為 100K pcs。","ts":null,"who":null},{"text":"上海合晶鄭州廠二期 2027 年月產能目標為 75K pcs。","ts":null,"who":null}],"title":"產能與擴產"},{"points":[{"text":"二林新廠將承接先進拋光片、化合物半導體載板等材料平台商業化布局。","ts":null,"who":null},{"text":"產品進程包含核心布局（先進拋光片）、擴展布局（方形晶片）及長期布局（LNOI）。","ts":null,"who":null}],"title":"產品與技術"},{"points":[{"text":"矽晶圓市況正經歷庫存去化、供需平衡並朝需求上升發展。","ts":null,"who":null}],"title":"產業與競爭"},{"points":[{"text":"2026年策略重點包含連結 AI 生態系重點客戶及拓展長期供應鏈合作。","ts":null,"who":null}],"title":"客戶"}],"guidance":[{"high_pct":null,"low_pct":null,"metric":"其他","period":"2026","quote":"二林基地一期建置完成","value_pct":null},{"high_pct":null,"low_pct":null,"metric":"其他","period":"2027","quote":"2027 月產能目標：100K pcs","value_pct":null},{"high_pct":null,"low_pct":null,"metric":"其他","period":"2027","quote":"2027 月產能目標：75K pcs","value_pct":null}],"tr":null}]}