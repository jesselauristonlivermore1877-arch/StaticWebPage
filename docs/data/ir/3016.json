{"code":"3016","name":"嘉晶","meetings":[{"date":"2026-09-22","note":"本公司受邀參加凱基證券於115年09月22日舉辦之法人說明會，說明公司營業成果及營運展望。","source":"簡報","deck_zh":"https://mopsov.twse.com.tw/nas/STR/301620260922M001.pdf","deck_en":"https://mopsov.twse.com.tw/nas/STR/301620260922E001.pdf","av":["http://irconference.twse.com.tw/3016_13_20260922_ch.mp4"],"memo":[{"title":"亮點","points":[{"text":"2026年上半年合併營收為23.68億元，年增28%，營業毛利率為21%，每股盈餘為1.00元。","ts":null,"who":null}]},{"title":"營收","points":[{"text":"2026年第二季整體營收季增24%、年增37%。","ts":null,"who":null}]},{"title":"毛利與獲利","points":[{"text":"受惠於AI伺服器電源架構升級及PMIC需求大增，2026年上半年營業毛利年增373%。","ts":null,"who":null}]},{"title":"營運指引","points":[{"text":"預估2026年下半年營收年增45%至50%，全年營收年增率大於35%，獲利同步強勁成長。","ts":null,"who":null}]},{"title":"產能與擴產","points":[{"text":"8吋矽磊晶產能目前滿載，2026年第一季已佔矽磊晶營收70%，正加速設備裝機與擴充產能，新增產能預計2027年逐季增加。","ts":null,"who":null}]},{"title":"產品與技術","points":[{"text":"6吋GaN產能利用率提升實現獲利轉虧為盈，6吋SiC日系IDM大廠於2026Q2正式量產。","ts":null,"who":null},{"text":"鍺矽(Ge/Si)PD磊晶通過國際一線客戶驗證並切入AI高速光通訊供應鏈，預計2026年底佔月營收約3%至5%。","ts":null,"who":null}]}],"guidance":[{"period":"2026Q3","metric":"營收YoY","value_pct":null,"low_pct":null,"high_pct":null,"quote":"26Q3 Fcst 營收成長 >15%"},{"period":"2026Q3","metric":"營收YoY","value_pct":null,"low_pct":null,"high_pct":null,"quote":"26Q3 Fcst 營收成長 >10%"},{"period":"2026Q3","metric":"營收YoY","value_pct":null,"low_pct":null,"high_pct":null,"quote":"26Q3 Fcst 營收成長> 70%"},{"period":"2026","metric":"營收YoY","value_pct":null,"low_pct":45.0,"high_pct":50.0,"quote":"2026 下半年營收預計YoY +45-50%"},{"period":"2026","metric":"營收YoY","value_pct":null,"low_pct":35.0,"high_pct":null,"quote":"2026 全年營收預計年增 >35% (YoY)"}],"tr":"3016_2026-09-22.json"},{"date":"2026-04-29","note":"本公司受邀參加凱基證券於115年04月29日舉辦之線上法人說明會，說明公司營業成果及營運展望。","source":null,"deck_zh":"https://mopsov.twse.com.tw/nas/STR/301620260429M001.pdf","deck_en":"https://mopsov.twse.com.tw/nas/STR/301620260429E001.pdf","av":["http://irconference.twse.com.tw/3016_12_20260429_ch.mp4","http://irconference.twse.com